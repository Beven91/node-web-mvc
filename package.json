{
  "private": true,
  "name": "node-web-mvc",
  "version": "1.0.0",
  "description": "node spring mvc",
  "workspaces": [
    "src/*"
  ],
  "directories": {
    "test": "test"
  },
  "scripts": {
    "watch-st": "cd src/node-web-mvc-starter && npm run watch",
    "watch": "cd src/node-web-mvc && npm run watch",
    "start": "node src/scripts/dev.js",
    "test": "cd src/node-web-mvc-test && jest"
  },
  "devDependencies": {
    "@types/express": "^4.17.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^14.0.6",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "ejs": "^3.1.3",
    "eslint": "^8.56.0",
    "eslint-config-google": "^0.9.1",
    "eslint-plugin-import": "^2.8.0",
    "eslint-plugin-node": "^5.2.1",
    "jest": "^30.5.2",
    "lodash": "^4.17.19",
    "ts-jest": "^29.4.15",
    "typescript": "5.5.4"
  }
}
