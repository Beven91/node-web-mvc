{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2017",
    "noImplicitAny": false,
    "removeComments": false,
    "esModuleInterop":true,
    "preserveConstEnums": true,
    "sourceMap": false,
    "declaration": true,
    "skipLibCheck": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators":true,
    "strictPropertyInitialization": false,
    "types": ["node"]
  },
  "exclude": [
    "node_modules",
    "src/register.js",
    "src/create-node-web-mvc"
  ]
}